# Groq API key (free) - https://console.groq.com/keys
GROQ_API_KEY=

# Model to use via Groq
GROQ_MODEL=openai/gpt-oss-120b

# Tavily search API key (free tier) - https://tavily.com
TAVILY_API_KEY=

# Optional - if unreachable, falls back to in-memory sessions
DB_URI=postgresql://admin:admin123@localhost:5432/research_agent

MAX_SEARCH_ITERATIONS=3
